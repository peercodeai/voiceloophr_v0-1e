# VoiceLoopHR Open-Source AI Backend Environment Configuration
# Copy this file to .env.local and configure your settings

# =============================================================================
# AWS Configuration
# =============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# =============================================================================
# Open-Source AI Service Endpoints
# =============================================================================
# vLLM (Large Language Model) endpoint
VLLM_ENDPOINT=http://your-ec2-instance:8000/v1

# OpenAI Whisper (Speech-to-Text) endpoint
WHISPER_ENDPOINT=http://your-ec2-instance:8001

# Coqui TTS (Text-to-Speech) endpoint
TTS_ENDPOINT=http://your-ec2-instance:8002

# Optional: API key for AI services (if authentication is enabled)
AI_SERVICE_API_KEY=your_ai_service_api_key_here

# AI service timeout in milliseconds (default: 30000)
AI_SERVICE_TIMEOUT=30000

# =============================================================================
# Database Configuration (Supabase)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# Application Configuration
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# =============================================================================
# Optional: OAuth Integrations (if using guest mode with integrations)
# =============================================================================
# Google OAuth & Drive Integration
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here

# LinkedIn Professional Network Integration
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# Microsoft Calendar Integration
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# =============================================================================
# Optional: Legacy OpenAI API (for fallback or comparison)
# =============================================================================
# Uncomment these if you want to use OpenAI API as fallback
# OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# Optional: Advanced Configuration
# =============================================================================
# Enable debug logging
DEBUG=voiceloophr:*

# Custom model configurations
DEFAULT_LLM_MODEL=microsoft/DialoGPT-medium
DEFAULT_WHISPER_MODEL=base
DEFAULT_TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# Rate limiting (requests per minute)
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# File upload limits
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_UPLOAD=10

# =============================================================================
# Production Configuration (for AWS deployment)
# =============================================================================
# Uncomment and configure for production deployment
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# NODE_ENV=production
# 
# # Use AWS RDS endpoint instead of Supabase
# DATABASE_URL=postgresql://username:password@your-rds-endpoint:5432/voiceloophr
# 
# # Use AWS S3 for file storage
# AWS_S3_BUCKET=your-s3-bucket-name
# AWS_S3_REGION=us-east-1
